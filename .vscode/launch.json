{
  "version": "1.0.0",
  "configurations": [
    {
      "name": "Debug Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1234",
      "webRoot": "${workspaceFolder}/dist"
    },
    {
      "name": "Debug Public (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5678",
      "webRoot": "${workspaceFolder}/dist-public"
    },
    {
      "name": "API",
      "request": "launch",
      "runtimeArgs": ["run-script", "start:api"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal"
    },
    {
      "name": "Client",
      "request": "launch",
      "runtimeArgs": ["run-script", "start:client"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal"
    },
    {
      "name": "Public",
      "request": "launch",
      "runtimeArgs": ["run-script", "start:public"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest: current file",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "jest.config.ts",
        "--runInBand"
      ],
      "env": {
        "NO_SCANNER": "true",
        "AWS_ACCESS_KEY_ID": "S3RVER",
        "AWS_SECRET_ACCESS_KEY": "S3RVER",
        "FILE_UPLOAD_MODAL_TIMEOUT": "1"
      },
      "console": "integratedTerminal",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    }
  ],
  "compounds": [
    {
      "name": "DAWSON local",
      "configurations": ["API", "Client", "Public"]
    }
  ]
}
