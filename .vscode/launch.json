{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/nodemon/bin/nodemon.js",
      "args": [
        "-e",
        "js,ts",
        "--ignore",
        "web-client/",
        "--ignore",
        "dist/",
        "--ignore",
        "dist-public/",
        "--ignore",
        "cypress/",
        "--exec",
        "bash -c '. ./setup-local-env.sh && (lsof -ti :9001 > /dev/null || nohup ./node_modules/.bin/s3rver -d web-api/storage/s3 -a 0.0.0.0 -p 9001 --configure-bucket noop-documents-local-us-east-1 web-api/cors-policy.xml --configure-bucket noop-temp-documents-local-us-east-1 web-api/cors-policy.xml > /dev/null 2>&1 < /dev/null &) && (lsof -ti :9229 > /dev/null || nohup env HOST=0.0.0.0 CODE=\"385030\" ./node_modules/.bin/cognito-local > /dev/null 2>&1 < /dev/null &) && node --inspect ./node_modules/.bin/ts-node --transpile-only web-api/src/app-local.ts'"
      ],
      "env": {
        "TS_NODE_TRANSPILE_ONLY": "true",
        "AWS_ACCESS_KEY_ID": "S3RVER",
        "AWS_SECRET_ACCESS_KEY": "S3RVER",
        "AWS_REGION": "us-east-1",
        "EFCMS_DOMAIN": "localhost",
        "ELASTICSEARCH_HOST": "localhost",
        "ELASTICSEARCH_ENDPOINT": "http://localhost:9200",
        "IRS_SUPERUSER_EMAIL": "irs-superuser@example.com",
        "USER_POOL_ID": "local_2pHzece7",
        "COGNITO_CLIENT_ID": "bvjrggnd3co403c0aahscinne",
        "DISABLE_EMAILS": "true",
        "ENV": "local",
        "USTC_ENV": "dev",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "example",
        "DATABASE_NAME": "postgres"
      },
      "preLaunchTask": "Prepare Local Environment",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "outputCapture": "std"
    },
    {
      "name": "Client",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:client"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "noDebug": true
    },
    {
      "name": "Public",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:public"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "noDebug": true
    },
    {
      "name": "Debug Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1234",
      "webRoot": "${workspaceFolder}/dist"
    },
    {
      "name": "Debug Public (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5678",
      "webRoot": "${workspaceFolder}/dist-public"
    },
    {
      "name": "Launch Edge",
      "request": "launch",
      "type": "msedge",
      "url": "http://localhost:1234",
      "webRoot": "${workspaceFolder}/dist"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest: unit test current file",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "jest.config.ts",
        "--maxWorkers",
        "1"
      ],
      "console": "integratedTerminal",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest: unit test current file (web-api config)",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "web-api/jest-unit.config.ts",
        "--maxWorkers",
        "1"
      ],
      "console": "integratedTerminal",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest: integration test current file",
      "env": {
        "STAGE": "local",
        "CI": "false",
        "NO_SCANNER": "true",
        "AWS_ACCESS_KEY_ID": "S3RVER",
        "AWS_SECRET_ACCESS_KEY": "S3RVER",
        "FILE_UPLOAD_MODAL_TIMEOUT": "1"
      },
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "web-client/jest-integration.config.ts"
      ],
      "console": "integratedTerminal",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    }
  ],
  "compounds": [
    {
      "name": "DAWSON local",
      "configurations": ["API", "Client", "Public"]
    },
    {
      "name": "Run All",
      "configurations": ["API", "Client", "Public", "Launch Edge"]
    }
  ]
}
