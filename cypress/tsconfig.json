{
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["es5", "dom"],
    "types": ["cypress", "node"],
    "rootDir": "../",
    "paths": {
      "@web-client/*": ["../web-client/src/*"],
      "@web-api/*": ["../web-api/src/*"],
      "@shared/*": ["../shared/src/*"],
      "*": ["../*"]
    }
  },
  "include": ["**/*.ts"]
}
