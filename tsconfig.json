{
  "compilerOptions": {
    "module": "commonjs",
    "allowJs": false,
    "noImplicitAny": false,
    "removeComments": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "types": [
      "jest",
      "node"
    ],
    "target": "ES2020",
    "jsx": "react",
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@web-client/*": [
        "web-client/src/*"
      ],
      "@web-api/*": [
        "web-api/src/*"
      ],
      "@shared/*": [
        "shared/src/*"
      ]
    }
  },
  "ts-node": {
    "files": true,
    "require": [
      "tsconfig-paths/register"
    ]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./eslint.config.mjs"],
  "exclude": [
    "node_modules",
    "targetBranch",
    "./cypress/**/*",
    "./cypress.config.ts",
    "./cypress-smoketests.config.ts",
    "./cypress-smoketests-readonly.config.ts",
    "./cypress-smoketests-readonly-public.config.ts",
    "./cypress-public.config.ts",
     "**/jest.config.ts"
  ]
}