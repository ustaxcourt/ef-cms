  "scripts": {
    "admin:become-user": "./scripts/user/become-user.ts",
    "admin:create-user": "./scripts/user/add-user.ts",
    "admin:download-case-documents": "./scripts/download-all-case-documents.ts",
    "admin:lookup-user": "./scripts/user/lookup-user.ts",
    "admin:resend-service-email-to-irs-superuser": "./scripts/email/resend-service-email-to-irs-superuser.ts",
    "build:all": "npm run clean && npm run build:assets && npm run build:client",
    "build:assets": "npx ts-node --transpile-only shared/createModule.ts",
    "build:client": "NODE_ENV=production USTC_ENV=prod PUBLIC_SITE_URL=$PUBLIC_SITE_URL node esbuild.config.mjs",
    "build:public": "USTC_ENV=prod PUBLIC_SITE_URL=$PUBLIC_SITE_URL node esbuild.public.config.mjs",
    "clean": "./reset-dependencies.sh CLEAN_ONLY",
    "clean:public": "rm -rf dist-public/",
    "cleanup:cypress-test-accounts": "./scripts/user/cleanup-cypress-test-accounts.ts",
    "cleanup:entity-validation": "./scripts/entity-validation/cleanupEntityValidation.ts",
    "cypress:file": "./scripts/tests/run-cypress.ts --file",
    "cypress:integration": "./scripts/tests/run-cypress.ts --suite integration",
    "cypress:integration:open": "./scripts/tests/run-cypress.ts --suite integration --open",
    "cypress:integration:public": "./scripts/tests/run-cypress.ts --suite public",
    "cypress:integration:public:open": "./scripts/tests/run-cypress.ts --suite public --open",
    "cypress:readonly": "./scripts/tests/run-cypress.ts --suite smoketestsReadonly",
    "cypress:readonly:open": "./scripts/tests/run-cypress.ts --suite smoketestsReadonly --open",
    "cypress:readonly:public": "./scripts/tests/run-cypress.ts --suite smoketestsReadonlyPublic",
    "cypress:readonly:public:open": "./scripts/tests/run-cypress.ts --suite smoketestsReadonlyPublic --open",
    "cypress:real-users": "./scripts/tests/run-cypress.ts --suite realUsers",
    "cypress:real-users:open": "./scripts/tests/run-cypress.ts --suite realUsers --open",
    "cypress:smoketests": "./scripts/tests/run-cypress.ts --suite smoketests",
    "cypress:smoketests:open": "./scripts/tests/run-cypress.ts --suite smoketests --open",
    "delete:api-gateway-mappings": "./scripts/delete-api-gateway-mappings.sh",
    "delete:elasticsearch-cluster": "./scripts/elasticsearch/delete-elasticsearch-cluster.sh",
    "deploy:account-specific": "cd web-api/terraform/applyables/account-specific && ../../bin/deploy-account-specific.sh",
    "deploy:allColors": "cd web-api/terraform/applyables/allColors && ../../bin/deploy-app-all-colors.sh",
    "deploy:blue": "cd web-api/terraform/applyables/blue && COLOR=blue ../../bin/deploy-app-color.sh",
    "deploy:ci-image": "./scripts/ecr/docker-to-ecr.sh",
    "deploy:ci-image:from": "./scripts/ecr/pull-and-tag.ts -e",
    "deploy:green": "cd web-api/terraform/applyables/green && COLOR=green ../../bin/deploy-app-color.sh",
    "deploy:public-ui:files": "./web-client/deploy-public.sh",
    "deploy:reindex-cron": "cd web-api/terraform/applyables/reindex-cron && ../../bin/deploy-reindex-cron.sh",
    "deploy:stale-cases-email-cron": "cd web-api/terraform/applyables/stale-cases-email-cron && ../../bin/deploy-stale-cases-email-cron.sh",
    "deploy:switch-colors-cron": "cd web-api/terraform/applyables/switch-colors-cron && ../../bin/deploy-switch-colors-cron.sh",
    "deploy:ui:files": "./web-client/deploy-ui.sh",
    "deploy:wait-for-workflow-cron": "cd web-api/terraform/applyables/wait-for-workflow && ../../bin/deploy-wait-for-workflow-cron.sh",
    "deploy:zipper": "cd web-api/terraform/modules/batch/docker-image && npm run deploy",
    "destroy:allColors": "cd web-api/terraform/applyables/allColors && ../../bin/destroy-app-all-colors.sh",
    "destroy:api": "cd web-api/terraform/main && ../bin/destroy-app.sh",
    "destroy:blue": "cd web-api/terraform/applyables/blue && COLOR=blue ../../bin/destroy-app-color.sh",
    "destroy:client": "cd web-client/terraform/main && ../bin/destroy-app.sh",
    "destroy:green": "cd web-api/terraform/applyables/green && COLOR=green ../../bin/destroy-app-color.sh",
    "destroy:reindex-cron": "cd web-api/terraform/applyables/reindex-cron && ../../bin/destroy-reindex-cron.sh",
    "destroy:stale-cases-email-cron": "cd web-api/terraform/applyables/stale-cases-email-cron && ../../bin/destroy-stale-cases-email-cron.sh",
    "destroy:switch-colors-cron": "cd web-api/terraform/applyables/switch-colors-cron && ../../bin/destroy-switch-colors-cron.sh",
    "destroy:wait-for-workflow-cron": "cd web-api/terraform/applyables/wait-for-workflow && ../../bin/destroy-wait-for-workflow-cron.sh",
    "dev:api-local": "run-p dev:app-local",
    "dev:app-local": "./run-api-local.sh",
    "docs": "npx docsify-cli serve ./docs",
    "ecr:check-version": "./scripts/ecr/check-version.sh",
    "esbuild:build": "node esbuild.config.mjs",
    "esbuild:start": "node esbuild.config.mjs -w",
    "git:backmerge-staging": "scripts/git/merge-staging-to.sh",
    "git:pr-to": "scripts/git/pr-to.sh",
    "git:push-to": "scripts/git/push-current-branch-to.sh",
    "init:api": "cd web-api/terraform/main && ../bin/deploy-init.sh",
    "init:ui": "cd web-client/terraform/main && ../bin/deploy-init.sh",
    "lint": "npm run lint:swagger & npm run lint:css & npm run lint:js/ts",
    "lint:css": "stylelint web-client/src/**/*.scss",
    "lint:css:file": "stylelint --",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:fix": "npm run lint:css:fix & npm run lint:js/ts:fix",
    "lint:js/ts": "TIMING=1 eslint cypress/ scripts/ shared/ web-api/ web-client/",
    "lint:js/ts:file": "TIMING=1 eslint --",
    "lint:js/ts:fix": "npm run lint:js/ts -- --fix",
    "lint:js/ts:fix:plain": "npm run lint:js/ts:fix -- --rule 'prettier/prettier: 0'",
    "lint:swagger": "swagger-cli validate web-api/swagger.json && swagger-cli validate docs/api/v1.yaml && swagger-cli validate docs/api/v2.yaml",
    "lint:swagger:file": "swagger-cli validate",
    "loadtest:pdf-generation": "npx ts-node --transpile-only ./web-api/storage/scripts/loadTest/loadTestPdfGeneration.ts",
    "maintenance:disengage": "./scripts/disengage-maintenance-mode.sh",
    "maintenance:disengage:local": ". ./setup-local-env.sh && ./scripts/send-maintenance-mode-notifications-locally.ts false",
    "maintenance:engage": "./scripts/engage-maintenance-mode.sh",
    "maintenance:engage:local": ". ./setup-local-env.sh && ./scripts/send-maintenance-mode-notifications-locally.ts true",
    "migration:cleanup": "./scripts/migration/update-deploy-table-after-migration.sh",
    "migration:generate:postgres": "npx ts-node --transpile-only ./web-api/src/persistence/postgres/utils/migrate/generateMigration.ts",
    "migration:postgres": "npx ts-node --transpile-only ./web-api/src/persistence/postgres/utils/migrate/migrate.ts",
    "migration:postgres:contract": "npx ts-node --transpile-only ./web-api/src/persistence/postgres/utils/migrate/migrate.ts contract",
    "migration:postgres:deprecated": "npx ts-node --transpile-only ./web-api/src/persistence/postgres/utils/migrate/migrateDeprecated.ts",
    "migration:rollback:postgres": "npx ts-node --transpile-only ./web-api/src/persistence/postgres/utils/migrate/rollback.ts",
    "postinstall": "husky install",
    "print:success": "echo 'Build successful. You can access the site at http://localhost:1234'",
    "reindex:elasticsearch": "./reindex-elasticsearch.sh",
    "reset:env": "scripts/persistence/truncate-all-persistence.ts",
    "secrets:rotate-circleci": "./scripts/user/rotate-circleci-secrets.sh",
    "secrets:rotate-environment": "./scripts/user/rotate-environment-secrets.ts",
    "seed": "npm run seed:s3",
    "seed:opensearch": "./web-api/seed-opensearch.sh",
    "seed:postgres": "npx ts-node --transpile-only ./web-api/src/persistence/postgres/utils/seed/seed.ts",
    "seed:s3": "cp -R ./web-api/storage/fixtures/s3/* ./web-api/storage/s3",
    "shell": "docker compose run -it shell /bin/bash",
    "start:all:ci": "npm run start:api:ci & npm run start:client:ci & npm run start:public:ci",
    "start:all:docker": "USTC_ENV=dev ./docker-local.sh",
    "start:api": "USTC_ENV=dev ./run-local.sh",
    "start:api:ci": "CI=true npm run start:api",
    "start:api:docker": "USTC_ENV=dev ./run-api.sh",
    "start:api:resume": "RESUME=true npm run start:api",
    "start:client": "WATCH=true FILE_UPLOAD_MODAL_TIMEOUT=1 USTC_ENV=dev ENV=local run-p start:client-host start:client:esbuild",
    "start:client-host": "servor dist index.html 1234",
    "start:client:ci": "CI=true NODE_ENV=production npm run start:client",
    "start:client:esbuild": "node esbuild.config.mjs",
    "start:client:no-scanner": "NO_SCANNER=true npm run start:client",
    "start:madge": "node ./graph-generators/index.js",
    "start:migration": "npx ts-node --transpile-only web-api/send-migration-segment-messages.ts",
    "start:pay-gov-test-server": "npx @ustaxcourt/ustc-pay-gov-test-server",
    "start:pay-gov-test-server:update-env": "npx @ustaxcourt/ustc-pay-gov-test-server update-env",
    "start:public": "CHECK_DEPLOY_DATE_INTERVAL=5000 WATCH=true USTC_ENV=dev ENV=local run-p start:public-host start:public:esbuild",
    "start:public-host": "servor dist-public index.html 5678",
    "start:public:esbuild": "node esbuild.public.config.mjs",
    "start:public:ci": "npm run clean:public && CI=true npm run start:public",
    "start:s3rver": "s3rver -d web-api/storage/s3 -a 0.0.0.0 -p 9001 --configure-bucket noop-documents-local-us-east-1 web-api/cors-policy.xml --configure-bucket noop-temp-documents-local-us-east-1 web-api/cors-policy.xml",
    "switch-colors": "./web-client/switch-colors.sh",
    "test:_client": "NO_SCANNER=true AWS_ACCESS_KEY_ID=S3RVER AWS_SECRET_ACCESS_KEY=S3RVER FILE_UPLOAD_MODAL_TIMEOUT=1 jest --runInBand --config web-client/jest.config.ts",
    "test:_client:parallel": "NO_SCANNER=true AWS_ACCESS_KEY_ID=S3RVER AWS_SECRET_ACCESS_KEY=S3RVER FILE_UPLOAD_MODAL_TIMEOUT=1 jest --maxWorkers=50% --config web-client/jest-unit.config.ts",
    "test:api": "npm run build:assets && jest --config web-api/jest-unit.config.ts --coverage --coverageProvider=babel",
    "test:api:file": "npm run build:assets && jest --config web-api/jest-unit.config.ts --coverage=false",
    "test:api:hosted-environment": "jest --config web-api/hostedEnvironmentTests/jest-hosted-environment.ts",
    "test:api:hosted-environment:file": "jest --config web-api/hostedEnvironmentTests/jest-hosted-environment.ts --coverage=false",
    "test:client:_integration": "NODE_ENV=integration NO_SCANNER=true AWS_ACCESS_KEY_ID=S3RVER AWS_SECRET_ACCESS_KEY=S3RVER jest --runInBand --config web-client/jest-integration.config.ts",
    "test:client:integration:ci": "NODE_ENV=integration npm run test:client:_integration -- --coverageDirectory=./coverage-integration-${CIRCLE_NODE_INDEX} ${JEST_TEST_RESULTS_ARGS} ${TESTFILES}",
    "test:client:integration:file": "NODE_ENV=integration CI=false NO_SCANNER=true AWS_ACCESS_KEY_ID=S3RVER AWS_SECRET_ACCESS_KEY=S3RVER FILE_UPLOAD_MODAL_TIMEOUT=1 jest --config web-client/jest-integration.config.ts -- ",
    "test:client:unit": "jest --config web-client/jest-unit.config.ts --coverage --coverageProvider=babel --testMatch '**/web-client/src/**/?(*.)+(spec|test).[jt]s?(x)'",
    "test:client:unit:ci": "jest --config web-client/jest-unit.config.ts --coverage --coverageProvider=babel --coverageDirectory=./coverage/${NODE_INDEX} ${JEST_TEST_RESULTS_ARGS} ${TESTFILES}",
    "test:client:unit:file": "jest --config web-client/jest-unit.config.ts --testMatch '**/web-client/src/**/?(*.)+(spec|test).[jt]s?(x)' --coverage=false",
    "test:document-generation": "npm run build:assets && jest --config shared/src/business/utilities/documentGenerators/jest_document_generator.config.ts",
    "test:document-generation:file": "npm run build:assets && jest --config shared/src/business/utilities/documentGenerators/jest_document_generator.config.ts --coverage=false",
    "test:file": "npm run build:assets && NODE_ENV=integration CI=false NO_SCANNER=true AWS_ACCESS_KEY_ID=S3RVER AWS_SECRET_ACCESS_KEY=S3RVER FILE_UPLOAD_MODAL_TIMEOUT=1 jest --config jest.config.ts --coverage=false -- ",
    "test:infrastructure": "jest --config aws/jest-infrastructure.config.ts --coverage --coverageProvider=babel",
    "test:infrastructure:file": "jest --config aws/jest-infrastructure.config.ts --coverage=false",
    "test:scripts": "jest --config scripts/jest-scripts.config.ts --coverage --coverageProvider=babel",
    "test:scripts:file": "jest --config scripts/jest-scripts.config.ts --coverage=false",
    "test:shared": "npm run build:assets && jest --config shared/jest-shared.config.ts --coverage --coverageProvider=babel",
    "test:shared:ci": "npm run build:assets && jest --config shared/jest-shared.config.ts --coverage --coverageProvider=babel --coverageDirectory=./coverage/${NODE_INDEX} ${JEST_TEST_RESULTS_ARGS} ${TESTFILES}",
    "test:shared:file": "npm run build:assets && jest --config shared/jest-shared.config.ts --coverage=false",
    "test:watch": "jest --watch .*test\\.js$",
    "validation:fingerprint": "npx ts-node --transpile-only ./scripts/entity-validation/entityValidation.ts",
    "verify-authorizers": "./scripts/circleci/verify-authorizers.sh",
    "verify-private-elasticsearch": "./scripts/circleci/verify-private-elasticsearch.sh",
    "visualize-bundle": "esbuild-visualizer --metadata ./metadata.json && open stats.html"
  },
